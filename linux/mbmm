def cmd_list(args) -> None:
    cat = catalog()
    state = load_state()
    enabled = set(state["profiles"][state["active"]]["mods"])
    rows = []
    for m in cat.get("mods", []):
        name = localized(m, "name", args.lang)
        summary = localized(m, "summary", args.lang)
        if args.search:
            q = args.search.lower()
            if q not in name.lower() and q not in summary.lower() and q not in m["id"]:
                continue
        if args.category and m.get("category") != args.category:
            continue
        rows.append((m, name, summary))
    for m, name, summary in rows:
        mark = "x" if m["id"] in enabled else " "
        inst = "installed" if installed(m["id"]) else "        "
        say(f"[{mark}] {m['id']:<18} {m.get('version','?'):<10} {inst}  {name}")
        if args.verbose:
            say(f"      {summary}")
    say(f"\n{len(rows)} mods; profile '{state['active']}'")


def cmd_show(args) -> None:
    mod = find_mod(catalog(), args.id)
    say(f"{localized(mod,'name',args.lang)}  ({mod['id']})")
    say(f"author:  {mod.get('author','?')}")
    say(f"version: {mod.get('version','?')}   category: {mod.get('category','?')}")
    say(f"type:    {mod.get('type','MelonMod')}")
    say(f"sha256:  {mod.get('sha256')}")
    say()
    say(localized(mod, "summary", args.lang))
    feedback = mod.get("feedback")
    if feedback:
        say(f"\nfeedback: {feedback}")


def cmd_install(args) -> None:
    cat = catalog()
    for mod_id in args.ids:
        download_mod(find_mod(cat, mod_id), force=args.force)
    if not args.no_enable:
        state = load_state()
        for mod_id in args.ids:
            if mod_id not in state["profiles"][state["active"]]["mods"]:
                state["profiles"][state["active"]]["mods"].append(mod_id)
        save_state(state)
        say(f"enabled in profile '{state['active']}'")
    if not args.no_apply and not args.no_enable:
        deploy(force=args.force)


def cmd_profile(args) -> None:
    state = load_state()
    if args.action == "list":
        for name, p in state["profiles"].items():
            mark = "*" if name == state["active"] else " "
            say(f"{mark} {name}: {', '.join(p['mods']) or '(empty)'}")
        return
    if args.action == "use":
        state["profiles"].setdefault(args.name, {"mods": []})
        state["active"] = args.name
        save_state(state)
        say(f"active profile: {args.name}")
        return
    if args.action in ("add", "remove"):
        mod_id = args.name
        if args.action == "add" and not installed(mod_id):
            die(f"{mod_id} is not installed (mbmm install {mod_id})")
        mods = state["profiles"][state["active"]]["mods"]
        if args.action == "add" and mod_id not in mods:
            mods.append(mod_id)
        if args.action == "remove" and mod_id in mods:
            mods.remove(mod_id)
        save_state(state)
        say(f"{args.action}: {mod_id}")
        return
    die("unknown profile action")


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="mbmm", description="Mechabellum mod manager for Linux/Proton")
    sub = p.add_subparsers(dest="cmd", required=True)

    sp = sub.add_parser("doctor", help="show game/prefix/MelonLoader status")
    sp.set_defaults(func=lambda a: doctor())

    sp = sub.add_parser("catalog", help="fetch or show the catalog")
    sp.add_argument("--refresh", action="store_true")
    sp.set_defaults(func=lambda a: (catalog(a.refresh),
                                    say(f"catalog: {len(catalog().get('mods', []))} mods, updated {catalog_age()}")))

    sp = sub.add_parser("list", help="list catalog mods")
    sp.add_argument("-s", "--search")
    sp.add_argument("-c", "--category")
    sp.add_argument("-v", "--verbose", action="store_true")
    sp.add_argument("--lang", default="en")
    sp.set_defaults(func=cmd_list)

    sp = sub.add_parser("show", help="show one mod")
    sp.add_argument("id")
    sp.add_argument("--lang", default="en")
    sp.set_defaults(func=cmd_show)

    sp = sub.add_parser("install", help="download, verify and enable mods")
    sp.add_argument("ids", nargs="+")
    sp.add_argument("--force", action="store_true")
    sp.add_argument("--no-enable", action="store_true")
    sp.add_argument("--no-apply", action="store_true")
    sp.set_defaults(func=cmd_install)

    sp = sub.add_parser("remove", help="remove an installed mod")
    sp.add_argument("id")
    sp.set_defaults(func=lambda a: remove_mod(a.id))

    sp = sub.add_parser("profile", help="manage profiles")
    sp.add_argument("action", choices=["list", "use", "add", "remove"])
    sp.add_argument("name", nargs="?")
    sp.set_defaults(func=cmd_profile)

    sp = sub.add_parser("apply", help="sync the active profile into the game")
    sp.add_argument("--force", action="store_true")
    sp.add_argument("--dry-run", action="store_true")
    sp.set_defaults(func=lambda a: deploy(a.force, a.dry_run))

    sp = sub.add_parser("melonloader", help="MelonLoader and .NET provisioning")
    sp.add_argument("action", choices=["install", "remove", "status"])
    sp.set_defaults(func=lambda a: {"install": melon_install,
                                    "remove": melon_remove,
                                    "status": melon_status}[a.action]())

    sp = sub.add_parser("launch", help="launch the game through Steam")
    sp.set_defaults(func=lambda a: launch())

    sp = sub.add_parser("gui", help="GTK4 interface")
    sp.set_defaults(func=lambda a: gui_main())

    return p


def main(argv: list[str] | None = None) -> None:
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    args = build_parser().parse_args(argv)
    try:
        args.func(args)
    except RuntimeError as exc:
        die(str(exc))
    except KeyboardInterrupt:
        die("interrupted", 130)


