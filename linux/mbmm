def doctor() -> None:
    game = find_game()
    say("mbmm doctor")
    say("-" * 50)
    say(f"catalog: {CATALOG_PATH if CATALOG_PATH.exists() else 'not fetched'} "
        f"({catalog_age()})")
    if not game:
        say("game: NOT FOUND in Steam libraries")
        return
    say(f"game: {game}")
    state = load_state()
    active = state["profiles"][state["active"]]["mods"]
    say(f"active profile: {state['active']} ({len(active)} enabled)")
    say(f"installed mods: {sum(1 for p in LIBRARY_DIR.glob('*') if p.is_dir())}")
    manifest = load_json(DEPLOY_PATH, {})
    say(f"deployed files: {len(manifest.get('files', {}))}")
    prefix = find_prefix(game)
    found = find_proton(game)
    say(f"proton: {found[1].name if found else 'NOT FOUND'}")
    if prefix:
        say(f"prefix: {prefix}")
        say(f".NET 6 Desktop: {'present' if dotnet6_ok(prefix) else 'MISSING'}")
    else:
        say("prefix: not created yet (launch once through Steam)")
    v = melon_version(game)
    say(f"MelonLoader: {v if v else 'not installed'}")
    if (game / "version.dll").exists():
        say("proxy: version.dll present")
    log = game / "MelonLoader/Latest.log"
    if log.exists():
        tail = log.read_text(encoding="utf-8", errors="ignore").strip().splitlines()[-1:]
        if tail:
            say(f"last MelonLoader log: {tail[0]}")


def launch() -> None:
    say("Launching Mechabellum through Steam...")
    subprocess.Popen(["steam", "-applaunch", APP_ID],
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)


