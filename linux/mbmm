def gui_main() -> None:
    try:
        import gi  # noqa: F401
        gi.require_version("Gtk", "4.0")
        from gi.repository import Gtk, GLib  # noqa: F401
    except (ImportError, ValueError):
        # The mise interpreter usually lacks PyGObject; the system one has it.
        for alt in ("/usr/bin/python3",):
            if Path(alt).exists() and os.path.realpath(alt) != os.path.realpath(sys.executable):
                os.execv(alt, [alt, os.path.abspath(__file__), "gui"])
        die("GTK4 (python-gobject) is not installed")

    import gi
    gi.require_version("Gtk", "4.0")
    from gi.repository import Gtk, GLib

    class Window(Gtk.ApplicationWindow):
        def __init__(self, app):
            super().__init__(application=app, title="Mechabellum Mod Manager")
            self.set_default_size(860, 640)
            self.state = load_state()
            self.cat = catalog()
            self.rows = []

            header = Gtk.HeaderBar()
            self.set_titlebar(header)
            refresh = Gtk.Button(label="Refresh")
            refresh.connect("clicked", self.on_refresh)
            header.pack_start(refresh)
            self.apply_btn = Gtk.Button(label="Apply")
            self.apply_btn.add_css_class("suggested-action")
            self.apply_btn.connect("clicked", self.on_apply)
            header.pack_end(self.apply_btn)
            launch_btn = Gtk.Button(label="Launch")
            launch_btn.connect("clicked", lambda *_: launch())
            header.pack_end(launch_btn)

            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            box.set_margin_top(8); box.set_margin_bottom(8)
            box.set_margin_start(8); box.set_margin_end(8)
            self.set_child(box)

            self.status = Gtk.Label(xalign=0)
            self.status.add_css_class("dim-label")
            box.append(self.status)

            search = Gtk.SearchEntry(placeholder_text="Filter mods")
            search.connect("search-changed", self.on_search)
            box.append(search)

            scroll = Gtk.ScrolledWindow(vexpand=True)
            self.listbox = Gtk.ListBox()
            self.listbox.set_selection_mode(Gtk.SelectionMode.NONE)
            scroll.set_child(self.listbox)
            box.append(scroll)

            self.rebuild()
            self.update_status()

        def update_status(self):
            game = find_game()
            parts = []
            if game:
                v = melon_version(game)
                parts.append(f"MelonLoader {v}" if v else "MelonLoader missing")
                prefix = find_prefix(game)
                if prefix:
                    parts.append(".NET6 ok" if dotnet6_ok(prefix) else ".NET6 missing")
            else:
                parts.append("game not found")
            parts.append(f"profile: {self.state['active']}")
            self.status.set_text("  ·  ".join(parts))

        def rebuild(self, query=""):
            while (child := self.listbox.get_first_child()) is not None:
                self.listbox.remove(child)
            enabled = set(self.state["profiles"][self.state["active"]]["mods"])
            for mod in self.cat.get("mods", []):
                name = localized(mod, "name")
                summary = localized(mod, "summary")
                if query and query.lower() not in (name + summary + mod["id"]).lower():
                    continue
                row = Gtk.ListBoxRow()
                hb = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
                hb.set_margin_top(6); hb.set_margin_bottom(6)
                check = Gtk.CheckButton()
                check.set_active(mod["id"] in enabled)
                check.connect("toggled", self.on_toggle, mod["id"])
                hb.append(check)
                info = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
                title = Gtk.Label(xalign=0, label=f"{name}  ·  {mod.get('version','')}")
                title.add_css_class("heading")
                sub = Gtk.Label(xalign=0, wrap=True, label=summary)
                sub.add_css_class("dim-label")
                info.append(title); info.append(sub)
                hb.append(info)
                row.set_child(hb)
                self.listbox.append(row)

        def on_toggle(self, check, mod_id):
            mods = self.state["profiles"][self.state["active"]]["mods"]
            if check.get_active() and mod_id not in mods:
                mods.append(mod_id)
            elif not check.get_active() and mod_id in mods:
                mods.remove(mod_id)
            save_state(self.state)
            self.update_status()

        def on_search(self, entry):
            self.rebuild(entry.get_text())

        def on_refresh(self, *_):
            self.cat = catalog(update=True)
            self.rebuild()
            self.update_status()

        def on_apply(self, *_):
            try:
                deploy()
                self.update_status()
                self.toast("Applied")
            except SystemExit as exc:
                self.toast(f"Apply failed: {exc}")

        def toast(self, text):
            dialog = Gtk.AlertDialog(message=text)
            dialog.show(self)

    class App(Gtk.Application):
        def __init__(self):
            super().__init__(application_id="io.github.saintromuald.Mbmm")

        def do_activate(self):
            win = Window(self)
            win.present()

    App().run([sys.argv[0]])


if __name__ == "__main__":
    main()
