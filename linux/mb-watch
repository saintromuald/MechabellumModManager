def write_outputs(conn, new_items: list[sqlite3.Row]) -> None:
    WATCH_DIR.mkdir(parents=True, exist_ok=True)
    rows = conn.execute("SELECT * FROM items ORDER BY status='new' DESC, score DESC, first_seen DESC").fetchall()
    with WATCHLIST.open("w", encoding="utf-8") as fh:
        fh.write("# Mechabellum watchlist\n\n")
        fh.write("Top-player replays and pro/tournament content. `mb-watch seen <id>` marks watched.\n\n")
        for r in rows:
            box = " " if r["status"] == "new" else "x"
            mark = "" if r["status"] == "new" else " ~~watched~~"
            fh.write(f"- [{box}] **{r['title']}**  \n")
            fh.write(f"  `{r['id']}` · {r['source']} · score {r['score']:.1f} · {r['url']}{mark}\n")
    with DIGEST.open("w", encoding="utf-8") as fh:
        fh.write(f"# Watch digest — {datetime.now().strftime('%Y-%m-%d %H:%M')}\n\n")
        if not new_items:
            fh.write("No new qualified items.\n")
        for r in sorted(new_items, key=lambda x: -x["score"]):
            fh.write(f"- **{r['title']}** ({r['source']}, score {r['score']:.1f})\n  {r['url']}\n")


def notify(new_replays: int, new_items: int) -> None:
    if not (new_replays or new_items):
        return
    body = f"{new_replays} new replay(s), {new_items} new link(s). See {WATCHLIST}"
    subprocess.run(["notify-send", "Mechabellum watch", body], check=False)


def run(args) -> None:
    cfg = config()
    WATCH_DIR.mkdir(parents=True, exist_ok=True)
    conn = db()
    before = conn.execute("SELECT COUNT(*) FROM items").fetchone()[0]
    replays, errors = 0, []

    if cfg.get("corpus", True):
        try:
            n, errs = check_corpus(conn, cfg, download=not args.no_download)
            replays += n
            errors += errs
        except Exception as exc:  # noqa: BLE001
            errors.append(f"corpus: {exc}")
            log(f"corpus failed: {exc}")
    if cfg.get("youtube", True):
        try:
            n, errs = check_youtube(conn, cfg)
            errors += errs
        except Exception as exc:  # noqa: BLE001
            errors.append(f"youtube: {exc}")
            log(f"youtube failed: {exc}")
    if cfg.get("reddit", True):
        try:
            n, errs = check_reddit(conn, cfg)
            errors += errs
        except Exception as exc:  # noqa: BLE001
            errors.append(f"reddit: {exc}")
            log(f"reddit failed: {exc}")
    if cfg.get("fogmoe", True):
        try:
            n, errs = check_fogmoe(conn, cfg)
            errors += errs
        except Exception as exc:  # noqa: BLE001
            errors.append(f"fogmoe: {exc}")

    conn.commit()
    after = conn.execute("SELECT COUNT(*) FROM items").fetchone()[0]
    cutoff = (datetime.now(timezone.utc) - timedelta(minutes=15)).isoformat(timespec="seconds")
    new_items = conn.execute(
        "SELECT * FROM items WHERE first_seen >= ? ORDER BY score DESC", (cutoff,)).fetchall()
    write_outputs(conn, new_items)
    conn.execute("INSERT INTO runs(ts,new_replays,new_items,errors) VALUES(?,?,?,?)",
                 (now(), replays, max(0, after - before), "; ".join(errors)))
    conn.commit()
    log(f"run complete: {replays} replays, {max(0, after - before)} items, {len(errors)} errors")
    if args.notify:
        notify(replays, max(0, after - before))


def cmd_list(args) -> None:
    conn = db()
    q = "SELECT * FROM items"
    where, params = [], []
    if args.source:
        where.append("source=?"); params.append(args.source)
    if not args.all:
        where.append("status='new'")
    if where:
        q += " WHERE " + " AND ".join(where)
    q += " ORDER BY score DESC, first_seen DESC LIMIT ?"
    params.append(args.limit)
    for r in conn.execute(q, params):
        print(f"{r['score']:.1f}\t{r['source']}\t{r['title'][:70]}\t{r['url']}")


def cmd_seen(args) -> None:
    conn = db()
    if args.all:
        conn.execute("UPDATE items SET status='watched' WHERE status='new'")
        print("marked all watched")
    else:
        for item_id in args.ids:
            conn.execute("UPDATE items SET status='watched' WHERE id=?", (item_id,))
        print("marked watched")
    conn.commit()


def cmd_sources(args) -> None:
    conn = db()
    for r in conn.execute("SELECT * FROM sources ORDER BY name"):
        print(f"{r['name']:<8} last_ok={r['last_ok'] or '-'}  error={r['last_error'] or '-'}")


def main() -> None:
    p = argparse.ArgumentParser(prog=APP)
    sub = p.add_subparsers(dest="cmd", required=True)

    sp = sub.add_parser("run", help="poll every source once")
    sp.add_argument("--notify", action="store_true")
    sp.add_argument("--no-download", action="store_true")
    sp.set_defaults(func=run)

    sp = sub.add_parser("list", help="list watchlist items")
    sp.add_argument("--source")
    sp.add_argument("--all", action="store_true")
    sp.add_argument("--limit", type=int, default=50)
    sp.set_defaults(func=cmd_list)

    sp = sub.add_parser("seen", help="mark items watched")
    sp.add_argument("ids", nargs="*")
    sp.add_argument("--all", action="store_true")
    sp.set_defaults(func=cmd_seen)

    sp = sub.add_parser("sources", help="source health")
    sp.set_defaults(func=cmd_sources)

    args = p.parse_args()
    try:
        args.func(args)
    except KeyboardInterrupt:
        sys.exit(130)


if __name__ == "__main__":
    main()
