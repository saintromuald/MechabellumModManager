def parse_header(path: Path) -> dict:
    meta = {"file": str(path), "date": "", "region": "", "blue": {}, "red": {},
            "build": "", "map_id": "", "seed": "", "battle_id": path.stem}
    parts = path.parts
    for i, part in enumerate(parts):
        if part == "tournaments" and i + 2 < len(parts):
            m = re.match(r"(\d{4}-\d{2}-\d{2})-(\w+)", parts[i + 1])
            if m:
                meta["date"], meta["region"] = m.group(1), m.group(2)
            meta["battle_id"] = Path(parts[i + 2]).stem
    side = None
    for line in path.open(encoding="utf-8", errors="ignore"):
        if line.startswith("blue:"):
            side = "blue"
        elif line.startswith("red:"):
            side = "red"
        elif line.startswith("build:"):
            meta["build"] = line.split(":", 1)[1].strip()
        elif line.startswith("map_id:"):
            meta["map_id"] = line.split(":", 1)[1].strip()
        elif side and re.match(r"\s+name:", line):
            meta[side]["name"] = line.split(":", 1)[1].strip().strip('"')
        elif side and re.match(r"\s+elo_score:", line):
            try:
                meta[side]["elo"] = int(line.split(":", 1)[1].strip())
            except ValueError:
                pass
        elif side and line and not line.startswith(" "):
            side = None
    return meta


def all_players(repo: Path) -> dict[str, int]:
    best: dict[str, int] = {}
    for path in (repo / "tournaments").rglob("*.yaml"):
        m = parse_header(path)
        for side in ("blue", "red"):
            name, elo = m[side].get("name"), m[side].get("elo", 0)
            if name:
                best[norm(name)] = max(best.get(norm(name), 0), elo)
    return best


def check_corpus(conn, cfg: dict, download: bool) -> tuple[int, list[str]]:
    repo = corpus_repo()
    if not repo:
        raise RuntimeError("corpus not found; run `mb-replay sync` once")
    errors = []
    try:
        subprocess.run(["git", "-C", str(repo), "fetch", "--depth", "1", "origin", "master"],
                       check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=120)
        subprocess.run(["git", "-C", str(repo), "reset", "--hard", "FETCH_HEAD"],
                       check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=60)
    except subprocess.CalledProcessError as exc:
        errors.append(f"corpus sync: {exc.stderr.decode(errors='ignore')[-200:]}")

    players = all_players(repo)
    pro_names = {n for n, e in players.items() if e >= cfg["min_elo"]}
    pro_names |= {norm(x) for x in cfg.get("extra_pros", [])}

    first_run = conn.execute("SELECT 1 FROM sources WHERE name='corpus' AND last_ok IS NOT NULL").fetchone() is None
    new_replays = 0
    added = []
    for path in sorted((repo / "tournaments").rglob("*.yaml")):
        m = parse_header(path)
        bid = m["battle_id"]
        elo = max(m["blue"].get("elo", 0), m["red"].get("elo", 0))
        qualifies = elo >= cfg["min_elo"] or norm(m["blue"].get("name", "")) in pro_names \
            or norm(m["red"].get("name", "")) in pro_names
        seen = conn.execute("SELECT 1 FROM seen WHERE id=?", (bid,)).fetchone()
        if seen:
            continue
        conn.execute("INSERT OR IGNORE INTO seen(id, first_seen) VALUES(?,?)", (bid, now()))
        if first_run:
            continue
        if not qualifies:
            continue

        title = f"{m['blue'].get('name','?')} vs {m['red'].get('name','?')}"
        url = f"https://github.com/qbisi/mechcore-replay/blob/master/tournaments/{m['date']}-{m['region']}/{bid}.yaml"
        item_id = f"corpus:{bid}"
        added.append((item_id, title, elo))
        conn.execute(
            "INSERT OR IGNORE INTO items(id,source,kind,title,url,author,published,score,meta,first_seen) "
            "VALUES(?,?,?,?,?,?,?,?,?,?)",
            (item_id, "corpus", "replay", title, url,
             f"{m['blue'].get('name','?')}, {m['red'].get('name','?')}",
             f"{m['date']}T00:00:00Z", elo, json.dumps(m, ensure_ascii=False), now()))

        if not download:
            continue
        archive = REPLAY_ARCHIVE / f"{bid}.grbr"
        if archive.exists():
            sha = __import__("hashlib").sha256(archive.read_bytes()).hexdigest()
            conn.execute("INSERT OR IGNORE INTO replays(battle_id,sha256,path,first_seen,meta) VALUES(?,?,?,?,?)",
                         (bid, sha, str(archive), now(), json.dumps(m, ensure_ascii=False)))
            continue
        REPLAY_ARCHIVE.mkdir(parents=True, exist_ok=True)
        proc = subprocess.run([str(MECHCORE), "convert", str(path), "--to", "grbr", str(archive)],
                              stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=180)
        if proc.returncode != 0:
            errors.append(f"convert {bid}: {proc.stderr.strip()[-160:]}")
            continue
        sha = __import__("hashlib").sha256(archive.read_bytes()).hexdigest()
        conn.execute("INSERT OR IGNORE INTO replays(battle_id,sha256,path,first_seen,meta) VALUES(?,?,?,?,?)",
                     (bid, sha, str(archive), now(), json.dumps(m, ensure_ascii=False)))
        g = game_dir()
        if g:
            target = g / "ProjectDatas/Replay" / archive.name
            target.parent.mkdir(parents=True, exist_ok=True)
            if not target.exists():
                shutil.copy2(archive, target)
        new_replays += 1
        log(f"corpus: {bid} {title} (elo {elo})")

    conn.execute("INSERT INTO sources(name,last_check,last_ok,last_error) VALUES('corpus',?,?,?) "
                 "ON CONFLICT(name) DO UPDATE SET last_check=excluded.last_check, last_ok=excluded.last_ok, last_error=excluded.last_error",
                 (now(), now(), "; ".join(errors) or None))
    return new_replays, errors


