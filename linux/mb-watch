def check_reddit(conn, cfg: dict) -> tuple[int, list[str]]:
    errors, added = [], 0
    data = None
    last_exc = None
    for attempt in range(3):
        try:
            data = http("https://www.reddit.com/r/Mechabellum/new/.rss", timeout=30)
            break
        except Exception as exc:  # noqa: BLE001
            last_exc = exc
            if isinstance(exc, urllib.error.HTTPError) and exc.code == 429 and attempt < 2:
                time.sleep(5 * (attempt + 1))
                continue
            break
    try:
        if data is None:
            raise last_exc or RuntimeError("no response")
        root = ET.fromstring(data)
    except Exception as exc:  # noqa: BLE001
        errors.append(f"reddit: {exc}")
        conn.execute("INSERT INTO sources(name,last_check,last_error) VALUES('reddit',?,?) "
                     "ON CONFLICT(name) DO UPDATE SET last_check=excluded.last_check, last_error=excluded.last_error",
                     (now(), str(exc)))
        return 0, errors

    ns = {"a": "http://www.w3.org/2005/Atom"}
    pro_names = [n for n in
                 {norm(x) for x in cfg.get("extra_pros", [])} |
                 {n for n, e in all_players(corpus_repo()).items() if e >= cfg["min_elo"]}
                 if len(n) >= 4]
    events = [e.casefold() for e in cfg.get("event_keywords", [])]
    for entry in root.findall("a:entry", ns):
        rid = entry.findtext("a:id", default="", namespaces=ns)
        title = entry.findtext("a:title", default="", namespaces=ns)
        content = entry.findtext("a:content", default="", namespaces=ns)
        link = entry.find("a:link", ns)
        url = link.get("href") if link is not None else ""
        published = entry.findtext("a:updated", default="", namespaces=ns)
        author = entry.findtext("a:author/a:name", default="", namespaces=ns)
        text = f"{title} {content}".casefold()
        if not any(k in text for k in ("replay", "vod", "tournament", "cast", "final",
                                       "mechacademy", "analysis", "gameplay")):
            continue
        hits_pro = any(p in text for p in pro_names)
        hits_event = any(e in text for e in events)
        if not (hits_pro or hits_event or "replay" in text):
            continue
        score = (2 if hits_pro else 0) + (2 if hits_event else 0) + \
                (1 if "replay" in text else 0) + (1 if "tournament" in text else 0)
        if score < 3:
            continue
        item_id = f"reddit:{rid or url}"
        if conn.execute("SELECT 1 FROM items WHERE id=?", (item_id,)).fetchone():
            continue
        conn.execute(
            "INSERT OR IGNORE INTO items(id,source,kind,title,url,author,published,score,meta,first_seen) "
            "VALUES(?,?,?,?,?,?,?,?,?,?)",
            (item_id, "reddit", "post", title, url, author, published, score,
             json.dumps({"content": content[:500]}), now()))
        added += 1
        log(f"reddit: {title[:70]}")
    conn.execute("INSERT INTO sources(name,last_check,last_ok,last_error) VALUES('reddit',?,?,?) "
                 "ON CONFLICT(name) DO UPDATE SET last_check=excluded.last_check, last_ok=excluded.last_ok, last_error=excluded.last_error",
                 (now(), now(), "; ".join(errors) or None))
    return added, errors


