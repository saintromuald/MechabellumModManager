# youtube
# --------------------------------------------------------------------------- #

def check_youtube(conn, cfg: dict) -> tuple[int, list[str]]:
    errors, added = [], 0
    pro_names = [n for n in
                 {norm(x) for x in cfg.get("extra_pros", [])} |
                 {n for n, e in all_players(corpus_repo()).items() if e >= cfg["min_elo"]}
                 if len(n) >= 4]
    trusted = {norm(x) for x in cfg.get("trusted_channels", [])}
    events = [e.casefold() for e in cfg.get("event_keywords", [])]
    cutoff = time.time() - cfg.get("max_age_days", 30) * 86400

    candidates = {}
    for query in cfg["youtube_queries"]:
        try:
            proc = subprocess.run(
                [YTDLP, f"ytsearch{cfg['youtube_results']}:{query}", "--flat-playlist",
                 "--dump-json", "--no-warnings", "--ignore-errors"],
                stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=120)
        except subprocess.TimeoutExpired:
            errors.append(f"youtube timeout: {query}")
            continue
        for line in proc.stdout.splitlines():
            try:
                d = json.loads(line)
            except json.JSONDecodeError:
                continue
            vid = d.get("id")
            if not vid or vid in candidates:
                continue
            title = d.get("title") or ""
            channel = d.get("channel") or ""
            duration = d.get("duration") or 0
            if duration < cfg["min_video_seconds"]:
                continue
            text = f"{title} {channel}".casefold()
            hits_pro = any(p in text for p in pro_names)
            hits_event = any(e in text for e in events)
            hits_channel = norm(channel) in trusted
            # Strict gate: a known pro/player name or a curated top-level channel.
            # Event keywords only raise the score, they do not admit unknown channels.
            if not (hits_pro or hits_channel):
                continue
            if "mechabellum" not in text and not hits_event:
                continue
            score = 0.0
            score += 3 if hits_channel else 0
            score += 3 if hits_event else 0
            score += 2 if hits_pro else 0
            score += 1 if "mechabellum" in text else 0
            score += 1 if duration >= 1200 else 0
            if score < 3:
                continue
            candidates[vid] = {"query": query, "title": title, "channel": channel,
                               "duration": duration, "score": score}

    # Flat search has no dates; fetch metadata for candidates not checked before.
    fresh = {vid: c for vid, c in candidates.items()
             if not conn.execute("SELECT 1 FROM seen WHERE id=?", (f"yt:{vid}",)).fetchone()}
    from concurrent.futures import ThreadPoolExecutor

    def meta(vid):
        try:
            proc = subprocess.run(
                [YTDLP, "--dump-json", "--no-warnings", "--no-playlist",
                 f"https://www.youtube.com/watch?v={vid}"],
                stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=90)
            if proc.returncode != 0 or not proc.stdout.strip():
                return vid, None
            d = json.loads(proc.stdout.splitlines()[0])
            ts = d.get("timestamp")
            if not ts and d.get("upload_date"):
                ts = int(datetime.strptime(d["upload_date"], "%Y%m%d").timestamp())
            return vid, (ts, d.get("view_count") or 0)
        except Exception:  # noqa: BLE001
            return vid, None

    with ThreadPoolExecutor(max_workers=4) as pool:
        fetched = dict(pool.map(meta, fresh))

    for vid, c in fresh.items():
        conn.execute("INSERT OR IGNORE INTO seen(id, first_seen) VALUES(?,?)", (f"yt:{vid}", now()))
        got = fetched.get(vid)
        if not got or not got[0]:
            continue
        ts, views = got
        if ts < cutoff:
            continue
        item_id = f"youtube:{vid}"
        if conn.execute("SELECT 1 FROM items WHERE id=?", (item_id,)).fetchone():
            continue
        score = c["score"] + min(2.0, math.log10(max(views, 1))) if views else c["score"]
        conn.execute(
            "INSERT OR IGNORE INTO items(id,source,kind,title,url,author,published,score,meta,first_seen) "
            "VALUES(?,?,?,?,?,?,?,?,?,?)",
            (item_id, "youtube", "video", c["title"],
             f"https://www.youtube.com/watch?v={vid}", c["channel"],
             datetime.fromtimestamp(ts, timezone.utc).isoformat(timespec="seconds"),
             score, json.dumps({"query": c["query"], "duration": c["duration"], "views": views}), now()))
        added += 1
        log(f"youtube: {c['title'][:70]} ({c['channel']})")
    conn.execute("INSERT INTO sources(name,last_check,last_ok,last_error) VALUES('youtube',?,?,?) "
                 "ON CONFLICT(name) DO UPDATE SET last_check=excluded.last_check, last_ok=excluded.last_ok, last_error=excluded.last_error",
                 (now(), now(), "; ".join(errors) or None))
    return added, errors


