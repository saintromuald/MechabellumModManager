# fogmoe releases (dormant until assets exist)
# --------------------------------------------------------------------------- #

def check_fogmoe(conn, cfg: dict) -> tuple[int, list[str]]:
    errors, added = [], 0
    try:
        rels = json.loads(http("https://api.github.com/repos/FogMoe/Mechabellum-Replays/releases", 30))
    except Exception as exc:  # noqa: BLE001
        errors.append(f"fogmoe: {exc}")
        rels = []
    for rel in rels if isinstance(rels, list) else []:
        for asset in rel.get("assets", []):
            if not asset.get("name", "").endswith(".zip"):
                continue
            item_id = f"fogmoe:{asset.get('id')}"
            if conn.execute("SELECT 1 FROM items WHERE id=?", (item_id,)).fetchone():
                continue
            conn.execute(
                "INSERT OR IGNORE INTO items(id,source,kind,title,url,author,published,score,meta,first_seen) "
                "VALUES(?,?,?,?,?,?,?,?,?,?)",
                (item_id, "fogmoe", "archive", asset["name"], asset.get("browser_download_url"),
                 "FogMoe/Mechabellum-Replays", rel.get("published_at"), 3,
                 json.dumps({"release": rel.get("tag_name"), "size": asset.get("size")}), now()))
            added += 1
    conn.execute("INSERT INTO sources(name,last_check,last_ok,last_error) VALUES('fogmoe',?,?,?) "
                 "ON CONFLICT(name) DO UPDATE SET last_check=excluded.last_check, last_ok=excluded.last_ok, last_error=excluded.last_error",
                 (now(), now(), "; ".join(errors) or None))
    return added, errors


